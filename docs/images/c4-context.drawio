<mxfile host="app.diagrams.net"><diagram name="c4-context" id="c4-context"><mxGraphModel pageWidth="1900" pageHeight="1200"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="pvz" value="Система ПВЗ&lt;br&gt;[Программная система]&lt;br&gt;Учёт отправлений и хранения,&lt;br&gt;отчётность по загрузке ПВЗ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#deebff;strokeColor=#4d6685;fontSize=29;fontColor=#23334a;" vertex="1" parent="1"><mxGeometry as="geometry" x="620" y="410" width="650" height="300" /></mxCell><mxCell id="employee" value="Сотрудник ПВЗ&lt;br&gt;[Человек]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dce9fa;strokeColor=#4d6685;fontSize=25;fontColor=#23334a;shape=umlActor;" vertex="1" parent="1"><mxGeometry as="geometry" x="55" y="430" width="340" height="200" /></mxCell><mxCell id="supervisor" value="Супервайзер региона&lt;br&gt;[Человек]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dce9fa;strokeColor=#4d6685;fontSize=25;fontColor=#23334a;shape=umlActor;" vertex="1" parent="1"><mxGeometry as="geometry" x="1395" y="175" width="430" height="200" /></mxCell><mxCell id="analyst" value="Операционный аналитик&lt;br&gt;сети [Человек]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dce9fa;strokeColor=#4d6685;fontSize=25;fontColor=#23334a;shape=umlActor;" vertex="1" parent="1"><mxGeometry as="geometry" x="1395" y="815" width="430" height="200" /></mxCell><mxCell id="e1" value="Принимает, выдаёт&lt;br&gt;и возвращает товары&lt;br&gt;через сайт" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=22;" edge="1" parent="1" source="employee" target="pvz"><mxGeometry as="geometry" relative="1"><Array as="points" /><mxPoint as="offset" x="0" y="-180" /></mxGeometry></mxCell><mxCell id="e2" value="Смотрит загрузку&lt;br&gt;своего региона&lt;br&gt;через конфигурацию 1С" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=22;" edge="1" parent="1" source="supervisor" target="pvz"><mxGeometry